# Copie para .env.local e ajuste.
# true = dados de exemplo no navegador (sem backend). false = usa a API em VITE_API_URL.
VITE_USE_MOCKS=true
# Com ou sem "/api/v1" no final. A origem do front (ex.: http://localhost:8080) precisa estar
# em FRONTEND_ORIGIN do orders-app/.env, senão o navegador bloqueia por CORS.
VITE_API_URL=http://localhost:3000
